[Unit]
Description=Emergency Tunnel (%i)
Documentation=https://github.com/emergency-tunnel/et
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=/usr/local/bin/et-core validate --config /etc/emergency-tunnel/%i.toml
ExecStart=/usr/local/bin/et-core run --config /etc/emergency-tunnel/%i.toml
Restart=always
RestartSec=2

# Resource discipline for small VPS targets. TasksMax bounds goroutine-backed
# threads; MemoryMax is a safety net (the core also self-limits its heap).
LimitNOFILE=1048576
TasksMax=4096
MemoryMax=256M
CPUWeight=100

# Security hardening. The core only needs to bind privileged ports and open
# outbound/inbound sockets; grant just that.
User=root
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/emergency-tunnel
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
