# Build output / release staging
# NOTE: these are anchored with a leading "/" so they only match built binaries
# at the repo root and do NOT match the source dir cmd/et-core/.
/release/
/dist/
/bin/
/et-core
/et-core-linux-*
/et-core-check
/et-core-test
*.exe

# Signing material — NEVER commit secret keys
*.key
*.sec
minisign.key

# Signatures/checksums are published to the web root, not the repo
*.minisig

# Logs & runtime
*.log
*.log.*

# Go
/vendor/
*.test
*.out

# Editor / OS cruft
.DS_Store
.idea/
.vscode/
*.swp
